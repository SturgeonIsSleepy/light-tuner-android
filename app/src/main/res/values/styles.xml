<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:colorControlActivated">@color/app_primary</item>
        <item name="android:colorControlNormal">@color/app_muted</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:colorBackgroundFloating">@color/app_surface</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/app_text</item>
        <item name="android:buttonStyle">@style/FlatButton</item>
        <item name="android:buttonBarButtonStyle">@style/FlatDialogButton</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:windowAnimationStyle">@style/DialogMotion</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:colorBackgroundFloating">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/app_text</item>
        <item name="android:buttonBarButtonStyle">@style/FlatDialogButton</item>
    </style>
    <style name="DialogMotion">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <style name="FlatButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>
    <style name="FlatDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>
</resources>
